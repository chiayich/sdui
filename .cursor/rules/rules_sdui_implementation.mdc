## 技术实现关键点

### 后端实现

1. **FastAPI UI端点**:
```python
from fastapi import FastAPI, Depends, HTTPException
from app.services.ui_service import UIService
from app.schemas.ui_schema import UIResponse

app = FastAPI()
ui_service = UIService()

@app.get("/api/ui/{screen_id}", response_model=UIResponse)
async def get_ui_config(
    screen_id: str,
    user_id: str = None,
    locale: str = "zh-CN",
    platform: str = "web",
    theme: str = "light"
):
    try:
        context = {
            "user_id": user_id,
            "locale": locale,
            "platform": platform,
            "theme": theme
        }
        return await ui_service.get_ui_config(screen_id, context)
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
```

2. **UI配置生成服务**:
```python
from app.models.ui_template import UITemplate
from app.models.component import Component
from app.services.user_service import UserService

class UIService:
    def __init__(self):
        self.user_service = UserService()
        
    async def get_ui_config(self, screen_id: str, context: dict):
        # 获取基础模板
        template = await UITemplate.get_by_screen_id(screen_id)
        if not template:
            raise ValueError(f"Template not found for screen: {screen_id}")
            
        # 根据用户上下文个性化配置
        if context.get("user_id"):
            user_data = await self.user_service.get_user_data(context["user_id"])
            template = self._personalize_template(template, user_data, context)
            
        # 应用主题和本地化
        template = self._apply_theme_and_locale(template, context)
        
        return {
            "version": template.version,
            "screen": {
                "id": screen_id,
                "title": template.title,
                "components": template.components
            }
        }
```

### 前端实现

1. **Vue3 SDUI渲染器**:
```typescript
// SDUIRenderer.vue
<template>
  <component
    v-if="rootComponent"
    :is="getComponentType(rootComponent.type)"
    v-bind="mapProps(rootComponent)"
    @action="handleAction"
  />
  <div v-else>Loading...</div>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue';
import { useUIStore } from '@/stores/uiStore';
import componentMap from '@/components/sdui';
import { fetchUIConfig } from '@/api/ui';

const props = defineProps<{
  screenId: string;
  context?: Record<string, any>;
}>();

const uiStore = useUIStore();
const rootComponent = ref(null);

const getComponentType = (type: string) => {
  return componentMap[type] || 'div';
};

const mapProps = (component: any) => {
  // 转换服务端属性为前端组件属性
  return {
    id: component.id,
    style: component.style,
    content: component.content,
    children: component.children,
    data: component.data,
    actions: component.actions,
  };
};

const handleAction = (action: any) => {
  // 处理组件触发的操作
  switch (action.type) {
    case 'navigate':
      // 处理导航
      break;
    case 'api_call':
      // 处理API调用
      break;
    case 'update_state':
      // 更新状态
      break;
    default:
      console.warn(`Unknown action type: ${action.type}`);
  }
};

onMounted(async () => {
  try {
    const config = await fetchUIConfig(props.screenId, props.context);
    rootComponent.value = config.screen;
    uiStore.setScreenConfig(props.screenId, config);
  } catch (error) {
    console.error('Failed to fetch UI config:', error);
  }
});
</script>
```

