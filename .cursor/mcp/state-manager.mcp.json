{
    "name": "state-manager",
    "description": "处理组件间数据流和状态共享",
    "version": "1.0.0",
    "capabilities": [
        "管理组件状态数据",
        "提供响应式数据更新",
        "处理状态依赖关系",
        "支持可预测的状态变更"
    ],
    "dependencies": [],
    "apis": [
        {
            "name": "createStore",
            "description": "创建状态存储",
            "params": [
                "initialState",
                "options"
            ]
        },
        {
            "name": "getState",
            "description": "获取状态值",
            "params": [
                "storeId",
                "path"
            ]
        },
        {
            "name": "setState",
            "description": "设置状态值",
            "params": [
                "storeId",
                "path",
                "value"
            ]
        },
        {
            "name": "subscribe",
            "description": "订阅状态变化",
            "params": [
                "storeId",
                "path",
                "callback"
            ]
        },
        {
            "name": "dispatch",
            "description": "分发状态操作",
            "params": [
                "storeId",
                "action",
                "payload"
            ]
        }
    ]
}