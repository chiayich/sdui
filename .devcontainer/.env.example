# SDUI开发环境端口配置示例文件
# 复制此文件为.env并根据您的本地环境调整端口号，以避免端口冲突

# 前端开发服务器端口 (默认: 5173)
# FRONTEND_PORT=3000

# 后端API服务器端口 (默认: 8000)
# BACKEND_PORT=8001

# PostgreSQL数据库端口 (默认: 5432)
# POSTGRES_PORT=5433

# Redis缓存端口 (默认: 6379)
# REDIS_PORT=6380

# 其他服务可能用到的端口
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=9091
# SKYWALKING_PORT=9093
# LOKI_PORT=9094 